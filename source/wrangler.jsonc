{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-weekly-meal-planning",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "tsconfig": "cloudflare/tsconfig.json",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-weekly-meal-planning",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "cloudflare/migrations",
    },
  ],
  "workflows": [
    {
      "binding": "MENU_WORKFLOW",
      "name": "family-weekly-meal-menu",
      "class_name": "MenuWorkflow",
    },
  ],
  "vars": {
    "AI_MAX_DAILY_REQUESTS": "3",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
