{
  "name": "weekday-table-react",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run prisma:generate && tsc --noEmit && tsc --noEmit -p cloudflare/tsconfig.json && tsc --noEmit -p api/tsconfig.json && vite build",
    "test": "vitest run && vitest run --config cloudflare/vitest.config.ts && npm run test:api",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cloudflare/tsconfig.json && tsc --noEmit -p api/tsconfig.json",
    "preview": "vite preview",
    "format": "prettier --write src tests",
    "dev:cloudflare": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:cloudflare": "vitest run --config cloudflare/vitest.config.ts",
    "postinstall": "node scripts/generate-prisma.mjs",
    "prisma:generate": "node scripts/generate-prisma.mjs",
    "dev:api": "tsx watch api/node.ts",
    "start:api": "tsx api/node.ts",
    "db:migrate:node": "tsx scripts/migrate-node.ts",
    "test:api": "vitest run --config api/vitest.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@netlify/blobs": "^11.1.6",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@reduxjs/toolkit": "2.13.0",
    "hono": "^4.13.16",
    "i18next": "^26.5.10",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.8",
    "react-redux": "9.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.6.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "28.1.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.9",
    "prisma": "^7.10.1",
    "sass": "1.105.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.156.0"
  }
}
